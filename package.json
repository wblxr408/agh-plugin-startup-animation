{
  "name": "@wblxr408/startup-animation-runtime",
  "version": "0.3.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "README.md",
    "LICENSE",
    "agh.market.json"
  ],
  "peerDependencies": {
    "react": "18.3.1"
  },
  "agnes": {
    "provides": [
      "ui"
    ],
    "plugins": [
      {
        "id": "ext:@wblxr408/startup-animation-runtime/main",
        "export": "main",
        "apiRange": "^5.0.0",
        "runtime": "in-process",
        "capabilities": {
          "ui": true
        },
        "metadata": {
          "displayName": "Agnes startup animation",
          "summary": "Plays a short, skippable intro when the Web workbench loads.",
          "description": "A terminal mark resolves into a light technical plate, orbital lockup and Agnes Harness signature.",
          "locales": {
            "zh-CN": {
              "displayName": "Agnes 开场动画",
              "summary": "工作台加载时播放可跳过的开场动画。",
              "description": "终端字符标志、浅色技术档案、环形扫描与 Agnes Harness 品牌揭幕。"
            }
          }
        }
      }
    ],
    "clientDescriptors": [
      {
        "rowId": "ext:@wblxr408/startup-animation-runtime/main",
        "path": "./src/agnes.client.json"
      }
    ],
    "metadata": {
      "displayName": "Agnes startup animation",
      "summary": "A skippable intro for the Agnes Web workbench.",
      "description": "A short Agnes Harness brand sequence played in the Web shell overlay.",
      "locales": {
        "zh-CN": {
          "displayName": "Agnes 开场动画",
          "summary": "Agnes Web 工作台的可跳过开场。",
          "description": "通过 Web 外壳的覆盖层播放 Agnes Harness 品牌动效。"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wblxr408/agh-plugin-startup-animation"
  },
  "author": "wblxr408",
  "keywords": [
    "agh-plugin",
    "agnes-harness",
    "startup-animation",
    "web-workbench"
  ]
}
